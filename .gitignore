# ============================================
# Terraform
# ============================================

# Terraform working directories
**/.terraform/

# Terraform state files
**/*.tfstate
**/*.tfstate.*

# Terraform variable files
# May contain environment-specific or sensitive values
**/*.tfvars
**/*.tfvars.json

# Terraform plan files
**/*.tfplan

# Terraform crash logs
**/crash.log
**/crash.*.log

# Terraform override files
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json


# ============================================
# AWS / ECS temporary configuration
# ============================================

task-definition.json
trust-policy.json


# ============================================
# Environment / secrets
# ============================================

.env
.env.*
!.env.example


# ============================================
# AWS credentials / keys
# ============================================

.aws/
*.pem
*.key


# ============================================
# OS files
# ============================================

.DS_Store
Thumbs.db


# ============================================
# IDE / Editor
# ============================================

.vscode/
.idea/


# ============================================
# Go
# ============================================

*.test
coverage.out


# ============================================
# Logs
# ============================================

*.log
